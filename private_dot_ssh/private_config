Host wirecode.lgcns.com
    HostName 52.78.40.120
    Port 7974
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host wirecode-team
    HostName wirecode.lgcns.com
    Port 7974
    User git
    IdentityFile ~/.ssh/id_ed25519
    # 서버와의 호환성을 위해 아래 옵션 추가
    KexAlgorithms +diffie-hellman-group14-sha1,diffie-hellman-group1-sha1
    HostkeyAlgorithms +ssh-rsa,ssh-dss
    PubkeyAcceptedAlgorithms +ssh-rsa

